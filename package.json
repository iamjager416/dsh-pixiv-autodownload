{
  "name": "dsh-pixiv-autodownload",
  "version": "0.1.1",
  "type": "module",
  "description": "Incremental Pixiv downloader for a fixed artist list. Remembers artist IDs and downloaded files, so a sync only fetches what is new.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamjager416/dsh-pixiv-autodownload.git"
  },
  "homepage": "https://github.com/iamjager416/dsh-pixiv-autodownload#readme",
  "bugs": {
    "url": "https://github.com/iamjager416/dsh-pixiv-autodownload/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "pixiv",
    "downloader"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "bin": {
    "pixiv-autodownload": "cli.js"
  },
  "files": [
    "index.js",
    "cli.js",
    "lib",
    "cordis.patch.yml",
    "locale",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
